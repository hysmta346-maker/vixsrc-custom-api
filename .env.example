# كل متغيرات البيئة اللي يقرأها السيرفر فعلياً (api/index.js + realtime/ + start.js).
# انسخه إلى .env واملأ القيم:  cp .env.example .env

# ==========================================================================
# مطلوبة إجبارياً — السيرفر يرفض الإقلاع بدونها (throw عند البدء)
# ==========================================================================
JWT_SECRET=jwt-demo-secret-2026-9fK7mQ2xP8vL4nR6zT1
SUBDL_API_KEY=subdl_uWL6Zo50HEC0ggBvDUIoZErytLu3FtjsENg7n1NAC20

# ==========================================================================
# الشبكة والتشغيل (start.js)
# ==========================================================================
PORT=
HOST=
# true فقط إذا في reverse proxy (nginx/caddy) قدام السيرفر؛ false للتجربة المحلية المباشرة
TRUST_PROXY=

# ==========================================================================
# التخزين والحماية من الإغراق (api/index.js)
# ==========================================================================
# مجلد دائم لحفظ device-keys.json وabuse-bans.json
DATA_DIR=
# أصول (origins) مسموحة لطلبات المتصفح؛ فاضي = بدون قيد (التطبيق نفسه لا يرسل Origin)
ALLOWED_ORIGINS=
# عدد مخالفات الحد (429) خلال يوم قبل الحظر
ABUSE_VIOLATION_THRESHOLD=
# مدة الحظر بالساعات
ABUSE_BAN_HOURS=

# ==========================================================================
# اختيارية — ميزات تُعطَّل تلقائياً بغيابها بدل ما يتوقف السيرفر
# ==========================================================================
# بدونه: /api/trailer يرجع 503 والتطبيق يخفي زر التريلر فقط
YOUTUBE_API_KEY=
# كوكي Febbox لمزود Showbox (إن وُجد)
FEBBOX_COOKIE=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJpYXQiOjE3ODYxMDY3ODMsIm5iZiI6MTc4NjEwNjc4MywiZXhwIjoxODE3MjEwODAzLCJkYXRhIjp7InVpZCI6MjI3NTA0MiwidG9rZW4iOiJjNTIwYTRiOWI0MTEyZmRhMDkyYmM4NjMzNGZhMzM0MSJ9fQ.NVBnjarE8g2er_BGiNiVLkQBu5ujl6mPqmw1nTyUxwE

# نظام توزيع المزودات عبر GitHub — التطبيق ينزّل منه أكواد المزودات (Showbox.js/vixsrc.js)
# ويشغّلها على الجهاز مباشرة، ويرجع لـ/api/stream فقط لو فشل. إحداثيات المستودع (إجبارية لتفعيل
# هذا النظام؛ لو تركتها فاضية، التطبيق يعتمد على /api/stream بس تلقائياً):
GITHUB_RAW_BASE=
GITHUB_USER=
GITHUB_REPO=
GITHUB_BRANCH=

# مسار كل ملف داخل المستودع أعلاه (اختيارية — القيم الافتراضية تطابق أسماء التطبيق نفسها،
# فلو تركتها فاضية بيستخدم هالمسارات تلقائياً؛ عدّلها فقط لو بنية مستودعك مختلفة):
# GITHUB_PROVIDER_JSON=github/provider.json
# GITHUB_CALLBACK_JSON=github/callback.json
# GITHUB_HOST_JSON=github/host.json
# GITHUB_CONFIG_JSON=github/config.json
# GITHUB_SUBS_JSON=github/subs.json
# GITHUB_PROVIDERS_DIR=github/providers/
# GITHUB_PROVIDER_SIGNATURES_JSON=github/provider-signatures.json
# GITHUB_UPDATE_JSON=github/update.json

# الإعلانات (Unity LevelPlay) — /api/ads/config
ADS_ENABLED=
APP_KEY=
INTERSTITIAL_AD_UNIT_ID=
ADS_INTERSTITIAL_COOLDOWN=

# يتطلب توفر جميع حلقات الموسم قبل عرضه كمكتمل
SERIES_REQUIRE_EPISODES=

# ==========================================================================
# غرف المشاهدة الجماعية (realtime/config.js) — اختيارية، لها قيم افتراضية معقولة
# ==========================================================================
ROOMS_MAX_MEMBERS=
ROOMS_MAX_TOTAL=
ROOMS_MAX_PER_DEVICE=
ROOMS_MAX_AGE_HOURS=
ROOMS_RECONNECT_GRACE_SECONDS=
ROOMS_CHAT_MAX_LENGTH=
WS_MAX_SOCKETS_PER_DEVICE=
WS_CONNECTIONS_PER_MINUTE_PER_IP=
